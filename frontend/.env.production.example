# Production build-time overrides. CRA loads this over the plain .env* files
# whenever `npm run build` runs with NODE_ENV=production, closing the gap
# where frontend/.env.development's localhost default could otherwise bleed
# into a production bundle built from this checkout.
#
# Leave REACT_APP_API_URL unset here: config/env.js, lib/apiClient.js and
# config/chat.js all default to same-origin (window.location.origin) when no
# REACT_APP_API_URL is supplied outside development, which is correct for the
# Nginx same-origin topology. Set it explicitly only if the deploy target
# needs a different API origin than the one serving the frontend.
REACT_APP_APP_NAME=FinSyntra AI
REACT_APP_VERSION=2.0.0
REACT_APP_ENABLE_ADMIN_LOGIN=true

# Public recruiter demo. LoginForm.js gates the entire demo-login panel
# (Admin/Finance/HR/Engineering/General) on this exact compile-time CRA
# variable — it has no effect at runtime, only at `npm run build` time.
# Without it, the backend demo-login endpoint still works, but no button to
# reach it is ever rendered. Verify this line is present in the ACTUAL
# `.env.production` file used for the build (see
# docs/NATIVE_DEPLOYMENT_RUNBOOK.md §5) before running `npm run build`.
REACT_APP_PUBLIC_DEMO_ENABLED=true
