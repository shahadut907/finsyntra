# FinSyntra environment template
# Copy to .env for local development. Never commit the resulting .env file.
# SECRET_KEY is required and must be replaced with a random value before use.
# Production startup rejects this placeholder.

# Runtime mode: dev, staging, or production
ENV=dev
DEBUG=true

# JWT signing and lifetime
SECRET_KEY=MUST_BE_SET_VIA_ENV
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application metadata
APP_NAME=FinSyntra RAG Chatbot (Local)
APP_VERSION=1.0.0

# Server
HOST=localhost
PORT=8000
FRONTEND_PORT=8501

# Database and optional Redis cache
# Leave DATABASE_URL empty to use the local development SQLite database.
DATABASE_URL=
REDIS_URL=
ENABLE_METRICS=false

# LLM provider. Local development keeps Ollama; portfolio production uses Groq.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
# Reasoning models (openai/gpt-oss-*) need room for hidden reasoning before the
# answer; "auto" sends reasoning_effort=low to gpt-oss models only.
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=auto
CHAT_DEFAULT_MODEL=prism
# Dictation requires the configured Groq provider. No client-side key.
SPEECH_ENABLED=true
SPEECH_MODEL=whisper-large-v3
SPEECH_MAX_BYTES=4000000
SPEECH_MAX_SECONDS=60
SPEECH_RATE_LIMIT_PER_MINUTE=8
SPEECH_TIMEOUT_SECONDS=30
LOCAL_EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# Embeddings provider: local (sentence-transformers) or cloudflare (Workers AI BGE-M3, no PyTorch).
EMBEDDINGS_PROVIDER=local
# Credentials for EMBEDDINGS_PROVIDER=cloudflare: set via the environment, never commit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDINGS_MODEL=@cf/baai/bge-m3
CLOUDFLARE_EMBEDDINGS_TIMEOUT_SECONDS=30
CLOUDFLARE_EMBEDDINGS_BATCH_SIZE=20
CLOUDFLARE_VECTOR_COLLECTION_NAME=company_docs_cloudflare_bgem3

# Timeout hierarchy. OLLAMA_TIMEOUT_SECONDS must be strictly less than
# RAG_HARD_TIMEOUT_SECONDS; startup refuses an incoherent pair.
OLLAMA_TIMEOUT_SECONDS=30
RAG_HARD_TIMEOUT_SECONDS=45
SSE_HEARTBEAT_SECONDS=15

# Tenant that owns the bundled corpus in VECTOR_DB_PATH's source directory.
BOOTSTRAP_TENANT_ID=tenant_acme

# Chroma persistence and retrieval/chunking settings
VECTOR_DB_PATH=./src/data/embeddings/chroma_db
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_TOKENS=2048
MAX_CONCURRENT_REQUESTS=1
TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_DEMO_CHAT_RATE_LIMIT_PER_MINUTE=3
DEMO_VISITOR_DAILY_LIMIT=10
DEMO_IP_DAILY_LIMIT=20
DEMO_GLOBAL_DAILY_LIMIT=60
DEMO_DAILY_TOKEN_BUDGET=180000
DEMO_GLOBAL_CONCURRENCY=2
TRUSTED_PROXY_HOPS=1
EDGE_PROXY_SECRET=
SUPER_ADMIN_BOOTSTRAP_TOKEN=
SUPER_ADMIN_EMAILS=[]
DEMO_SUPER_ADMIN_TOKEN_RESERVE=40000
DEMO_DAILY_TOKEN_BUDGET_CEILING=200000
PUBLIC_DEMO_LOGIN_RATE_LIMIT_PER_MINUTE=30

# Enterprise RAG storage and rollout flags (defaults mirror the Settings model;
# every flag except BLOCK_BACKUP_FOLDERS is off unless explicitly enabled).
VECTOR_COLLECTION_NAME=company_docs
RAW_DOCUMENTS_PATH=./src/data/raw
STRICT_MODE=false
TENANT_SCOPING_ON=false
ENABLE_DELETION_WORKER=false
ENABLE_RECONCILIATION=false
BLOCK_BACKUP_FOLDERS=true
CANONICAL_COLLECTION_ENFORCED=false
ENABLE_CROSS_PROCESS_CACHE_SYNC=false
ENABLE_UPLOAD_LOGGING=false
REDIS_CACHE_INVALIDATION_CHANNEL=finsolve:cache:invalidation
DELETION_WORKER_BATCH_SIZE=10

# Portfolio demo. Demo login remains normal JWT/cookie/JTI authentication and
# only permits the predefined tenant_demo identities.
PUBLIC_DEMO_ENABLED=false
DEMO_TENANT_ID=tenant_demo
DEMO_DOCUMENTS_PATH=./src/data/demo_corpus

# Pydantic list values must use JSON syntax.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:8501"]

# Development-only controls
ADMIN_USERS=
BYPASS_AUTH=false

# Refresh-token lifetime, cookie policy, upload limits, and log level are not
# configurable fields in the current Settings model.
