{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend && npm ci --prefix landing-source/finsolve_ai_landing",
  "buildCommand": "sh deploy/vercel/build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://finsyntra-demo-api.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://finsyntra-demo-api.onrender.com/auth/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://finsyntra-demo-api.onrender.com/health/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
