# Railway deployment template using the names declared by src/config/settings.py.
# Configure these values in the Railway dashboard; do not commit a populated file.

ENV=production
DEBUG=false
SECRET_KEY=MUST_BE_SET_VIA_ENV
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

HOST=0.0.0.0
PORT=8000
DATABASE_URL=
REDIS_URL=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
LOCAL_EMBEDDINGS_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./src/data/embeddings/chroma_db

ALLOWED_ORIGINS=[]
BYPASS_AUTH=false
ENABLE_METRICS=false

