# FinSyntra local and generated content

# Environment and secret material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
jwt_key.txt
secret_key.txt
cookies.txt
cookies-*.txt
*session*.dump

# Python caches and build output
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test, type-check, lint, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
test_report_*.json

# Runtime databases and state
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
data/**
!data/.gitkeep

# Local operator backups of runtime stores (never commit these)
backups/

# Uploads, embeddings, and Chroma persistence
src/data/raw/**
!src/data/raw/.gitkeep
src/data/embeddings/**
!src/data/embeddings/.gitkeep
uploads/
upload/
chroma/
chroma_db/

# Generated exports and temporary files
exports/
generated_exports/
output/
*.export.*
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.pid.lock
_patch_*.py
/debug_*.py
/diagnostic_*.py
/diagnostic_*.html
/db_test.py
/installed.txt

# Logs, runtime output, and diagnostic dumps
logs/
*.log
server_log.txt
server_stdout.txt
server_stderr.txt
uvicorn_out*.txt
uvicorn_err*.txt
diagnostics/

# Frontend dependencies, environments, and build output
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.cache/
frontend/.parcel-cache/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating-system metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
NUL

# Deployment templates that must stay tracked (placeholders only, no values)
!.env.production.example
!frontend/.env.production.example
!deploy/production/.env.production.example

# Local assistant/tool permissions (per-developer, never shared)
.claude/settings.local.json

.vercel
