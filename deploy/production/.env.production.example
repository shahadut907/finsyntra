# FinSyntra native production environment template.
# Copy to /etc/finsolve/finsolve.env (mode 0640, owned by root:finsolve), fill
# in real values, and NEVER commit the filled-in copy. Referenced by
# deploy/production/finsolve.service via EnvironmentFile=.

ENV=production
DEBUG=false

# JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME="FinSyntra RAG Chatbot"
APP_VERSION=1.0.0

# Backend binds loopback-only; Nginx is the public edge.
HOST=127.0.0.1
PORT=8000

# SQLite path under persistent storage (see systemd unit's StateDirectory).
DATABASE_URL=sqlite:////var/lib/finsolve/finsolve.db

# LLM provider. Production uses Groq; local dev keeps Ollama (unused here).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
# Reasoning models (openai/gpt-oss-*) spend completion tokens on hidden
# reasoning first; too small a budget returns an empty answer
# (finish_reason=length). "auto" sends reasoning_effort=low only to gpt-oss
# models; set low|medium|high explicitly, or "none" to never send it.
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=auto
LOCAL_EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# SentenceTransformer/huggingface_hub cache. Without this, the library
# defaults to the finsolve service user's home cache dir (~/.cache/huggingface,
# i.e. under /opt/finsolve), which systemd's ProtectSystem=strict makes
# read-only — only /var/lib/finsolve (StateDirectory) is writable. HF_HOME
# alone is sufficient: huggingface_hub derives HUGGINGFACE_HUB_CACHE and
# HF_HUB_CACHE from it when those are not set independently (verified against
# the installed huggingface_hub/sentence-transformers version's own source).
# First boot still needs outbound HTTPS access to huggingface.co to populate
# this cache, unless it is pre-populated before the service starts.
HF_HOME=/var/lib/finsolve/hf-cache

# Timeout hierarchy: GROQ_TIMEOUT_SECONDS must stay strictly below
# RAG_HARD_TIMEOUT_SECONDS or startup refuses to boot.
RAG_HARD_TIMEOUT_SECONDS=45
SSE_HEARTBEAT_SECONDS=15

BOOTSTRAP_TENANT_ID=tenant_acme

# Persistent storage — see docs/NATIVE_DEPLOYMENT_RUNBOOK.md for the directory
# layout and ownership these paths assume.
VECTOR_DB_PATH=/var/lib/finsolve/chroma
VECTOR_COLLECTION_NAME=company_docs
RAW_DOCUMENTS_PATH=/var/lib/finsolve/raw

CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_TOKENS=2048
MAX_CONCURRENT_REQUESTS=4
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_DEMO_CHAT_RATE_LIMIT_PER_MINUTE=10

# Must be explicit HTTPS origin(s) — startup rejects "*" or non-HTTPS in
# production. Replace with the real public origin.
ALLOWED_ORIGINS='["https://finsolve.example.com"]'

# Public portfolio demo. Demo Admin/Employee share DEMO_TENANT_ID and cannot
# mutate shared documents/users — enforced server-side regardless of this flag.
PUBLIC_DEMO_ENABLED=true
DEMO_TENANT_ID=tenant_demo
DEMO_DOCUMENTS_PATH=/var/lib/finsolve/demo_corpus

BYPASS_AUTH=false
